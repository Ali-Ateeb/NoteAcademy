# ---- Database ----
# Local:    postgresql://postgres:postgres@localhost:5432/noteacademy
# Supabase: the "Session pooler" connection string from Project Settings > Database
DATABASE_URL=

# ---- Supabase (web app) ----
# Leave these unset to run the web app against the local seed fixtures in
# web/src/lib/data/seed/ — the app detects that and works with no backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Object storage (paper PDFs and question crops) ----
# S3-compatible: Cloudflare R2, AWS S3, or Supabase Storage's S3 endpoint.
STORAGE_ENDPOINT=
STORAGE_BUCKET=noteacademy-papers
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ---- Ingestion pipeline ----
ANTHROPIC_API_KEY=
# Extraction model. Keep the most capable model here: a tagging or segmentation
# error is permanent and silently poisons every downstream feature.
NOTEACADEMY_EXTRACTION_MODEL=claude-opus-5
# Embeddings for the topical search + AI solver retrieval index.
# Anthropic does not serve an embeddings endpoint; Voyage is the provider
# Anthropic's own docs point at, and voyage-3 is 1024-dim (see migration 0007).
VOYAGE_API_KEY=
NOTEACADEMY_EMBEDDING_MODEL=voyage-3
