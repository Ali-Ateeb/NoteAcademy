# Copy to .env at the repository root and fill in.
#
# This file configures the DATABASE and the INGESTION PIPELINE.
# The web app is configured separately in web/.env.local — Next.js does not read
# this file. See web/.env.example.
#
# .env is gitignored. Never commit real keys.

# ---- Database ----
# Local:    postgresql://postgres:postgres@localhost:5432/noteacademy
# Supabase: Project Settings -> Database -> Connection string -> Session pooler
# Used by psql for migrations and by the pipeline's loader.
DATABASE_URL=

# ---- Ingestion pipeline ----
# Not needed for multiple-choice papers: their answer keys parse from the mark
# scheme's text layer and their questions segment geometrically, both without a
# model. Required for structured papers, topic tagging, and the vision fallback.
ANTHROPIC_API_KEY=

# Extraction model. Keep the most capable model here: a segmentation or tagging
# error is written once and then silently degrades every feature built on it.
NOTEACADEMY_EXTRACTION_MODEL=claude-opus-5

# Embeddings for topical search and the AI solver's retrieval index.
# Anthropic does not serve an embeddings endpoint; Voyage is the provider
# Anthropic's own docs point at, and voyage-3 is 1024-dim (see migration 0007).
VOYAGE_API_KEY=
NOTEACADEMY_EMBEDDING_MODEL=voyage-3

# ---- Object storage (paper PDFs and question crops) ----
# S3-compatible: Cloudflare R2, AWS S3, or Supabase Storage's S3 endpoint.
# Not needed until the viewer serves real documents.
STORAGE_ENDPOINT=
STORAGE_BUCKET=noteacademy-papers
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
