# Copy to .env at the repository root and fill in.
#
# This file configures the DATABASE and the INGESTION PIPELINE.
# The web app is configured separately in web/.env.local — Next.js does not read
# this file. See web/.env.example.
#
# .env is gitignored. Never commit real keys.

# ---- Database ----
# Local:    postgresql://postgres:postgres@localhost:5432/noteacademy
# Supabase: Project Settings -> Database -> Connection string -> Session pooler
# Used by psql for migrations and by the pipeline's loader.
DATABASE_URL=

# ---- Ingestion pipeline ----
# Not needed for multiple-choice papers: their answer keys parse from the mark
# scheme's text layer and their questions segment geometrically, both without a
# model. Required for structured papers, topic tagging, and the vision fallback.
# Get one from aistudio.google.com -> Get API key.
GOOGLE_API_KEY=

# Extraction model. Keep the most capable model here: a segmentation or tagging
# error is written once and then silently degrades every feature built on it.
# Pinned rather than an alias — Google retires these outright rather than
# repointing them, so expect to bump this by hand occasionally.
NOTEACADEMY_EXTRACTION_MODEL=gemini-3.6-flash

# Embeddings for topical search and the AI solver's retrieval index.
# Gemini does not serve an embeddings endpoint under this same key; Voyage is
# a separate provider, and voyage-3 is 1024-dim (see migration 0007).
VOYAGE_API_KEY=
NOTEACADEMY_EMBEDDING_MODEL=voyage-3

# A second provider for the two stages that call a model directly
# (extract.py's vision pass, tagging.py's direct-API tagger) and for automated
# tag verification (tag-verify-auto) — DeepSeek, OpenAI-format API at
# api.deepseek.com (see pipeline/noteacademy_pipeline/deepseek.py). Not needed
# at all unless you would rather run on DeepSeek than on Gemini. Get a key at
# platform.deepseek.com; the account needs a balance, or every call returns 402.
DEEPSEEK_API_KEY=
# "gemini" (default) or "deepseek". Independent switches: extraction needs
# vision, tagging doesn't, so one can run on DeepSeek without the other. An
# unrecognised value is an error, not a silent fall-back to Gemini.
NOTEACADEMY_TAGGING_PROVIDER=gemini
NOTEACADEMY_EXTRACTION_PROVIDER=gemini
# Two models because DeepSeek's differ: deepseek-v4-pro is the stronger one and
# is text-only; deepseek-flash is the one that reads images. Tagging uses the
# first; extraction and tag-verify-auto (which show the model a page or a crop)
# must use the second. Names are DeepSeek's own as of 2026-09 — override if
# the lineup has moved.
NOTEACADEMY_DEEPSEEK_TEXT_MODEL=deepseek-v4-pro
NOTEACADEMY_DEEPSEEK_VISION_MODEL=deepseek-flash
# DeepSeek's "thinking" mode is ON at the API by default and is billed as output
# tokens. This pipeline sends it OFF unless you set this: the stages run
# sequentially over thousands of items, where it is the difference between
# minutes and hours per subject. Turn it on (1/true/on) where accuracy is worth
# the wait.
NOTEACADEMY_DEEPSEEK_THINKING=0

# The sittings the pipeline is working through (inclusive). The automated tag
# verifiers only read papers in this range, by default; override per run with
# --from-year / --to-year. Papers outside it stay in the database and stay live.
NOTEACADEMY_YEAR_FROM=2016
NOTEACADEMY_YEAR_TO=2026

# ---- Supabase Storage ----
# The simplest object storage if you are already on Supabase: no second account,
# and the service role key you already have is the only credential needed. The
# pipeline uploads question crops here and the web app hands out short-lived
# signed URLs; the bucket itself stays private.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Object storage (paper PDFs and question crops) ----
# S3-compatible: Cloudflare R2, AWS S3, or Supabase Storage's S3 endpoint.
# Not needed until the viewer serves real documents.
STORAGE_ENDPOINT=
STORAGE_BUCKET=noteacademy-papers
# Public bucket holding copies of APPROVED crops only, served from Supabase's CDN.
# Filled by `noteacademy sync-public-crops`. Use the same name as
# NEXT_PUBLIC_CROP_BUCKET in web/.env.local.
STORAGE_PUBLIC_BUCKET=noteacademy-crops
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
