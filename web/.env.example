# Copy to web/.env.local and fill in. Next.js reads .env.local from THIS
# directory (the Next.js project root) — a .env file at the repository root is
# not read by the web app.
#
# .env.local is gitignored. Never commit real keys.

# ---- Supabase ----
# Supabase dashboard -> Project Settings -> API

# Project URL. Safe to expose: it ships to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Also safe to expose — it is designed to be
# public, and row level security (db/migrations/0008_rls.sql) is what actually
# protects the data. Publishing it is not a leak; disabling RLS would be.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key. NEVER prefix this with NEXT_PUBLIC_, and never import
# it into a client component: it bypasses row level security entirely, so in a
# browser bundle it hands every visitor full read/write on every table.
# Server-side route handlers and server components only.
SUPABASE_SERVICE_ROLE_KEY=

# Leave every value above blank to run against the local seed fixtures.
# The app detects that and works with no backend at all.
