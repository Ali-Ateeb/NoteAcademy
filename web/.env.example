# Copy to web/.env.local and fill in. Next.js reads .env.local from THIS
# directory (the Next.js project root) — a .env file at the repository root is
# not read by the web app.
#
# .env.local is gitignored. Never commit real keys.

# ---- Supabase ----
# Supabase dashboard -> Project Settings -> API

# Project URL. Safe to expose: it ships to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Also safe to expose — it is designed to be
# public, and row level security (db/migrations/0008_rls.sql) is what actually
# protects the data. Publishing it is not a leak; disabling RLS would be.
#
# Also what signs students in: web/src/lib/supabase/browserClient.ts and
# serverClient.ts use this same key for the session-aware clients, so Supabase
# Auth (email + password) only works once this is set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The "service_role" key. NEVER prefix this with NEXT_PUBLIC_, and never import
# it into a client component: it bypasses row level security entirely, so in a
# browser bundle it hands every visitor full read/write on every table.
# Server-side route handlers and server components only.
SUPABASE_SERVICE_ROLE_KEY=

# Leave every value above blank to run against the local seed fixtures.
# The app detects that and works with no backend at all.

# ---- Reviewer access ----
# No variable to set here. /admin/review and /api/review are gated by a real
# Supabase Auth account with profiles.is_reviewer = true
# (db/migrations/0029_reviewer_accounts.sql), not a shared secret.
#
# To make an account a reviewer: sign up normally through the app (so a
# profiles row exists), then grant access directly in the database —
# is_reviewer can only be set outside the anon/authenticated API roles, so
# this has to run from the SQL editor or DATABASE_URL, not through the app:
#
#   update profiles set is_reviewer = true where email = 'you@example.com';

# ---- AI solver ----
# Powers /api/solve (the "Get worked solution" button). Server-side only —
# never prefix with NEXT_PUBLIC_. Unset disables the button rather than
# failing requests: SolutionButton and the route both check for it.
# aistudio.google.com -> Get API key
GOOGLE_API_KEY=

# Defaults to gemini-3.6-flash. Override to trade solution quality for cost.
SOLVER_MODEL=
